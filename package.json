{
  "name": "kora",
  "productName": "KORA",
  "author": "Lucky",
  "license": "UNLICENSED",
  "description": "Voice Assistant for Desktop",
  "homepage": "https://github.com/Lucky-7643/KORA",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run lint && tsx src/server/index.ts",
    "build": "npm run lint && vite build && npm run build:server && npm run validate:build",
    "build:server": "esbuild src/server/index.ts --bundle --external:express --external:ws --external:dotenv --external:vite --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs",
    "validate:build": "test -f dist/server.cjs && test -d dist/assets && echo '✓ Build validation passed'",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist *.js *.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
